{
  "name": "agent402-model-provider",
  "version": "0.7.0",
  "description": "Agent402 model provider for use with OpenClaw (Agentic Finance over x402 or MPP): an auto-routed tier at a flat per-call price and explicit LLM models priced per request, paid in USDC over x402, or with a prepaid credits key, through a local proxy. Zero dependencies; x402 wallet payment is an optional peer. Formerly agent402-openclaw.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./proxy": {
      "types": "./proxy.d.ts",
      "default": "./proxy.js"
    },
    "./models": {
      "types": "./models.d.ts",
      "default": "./models.js"
    }
  },
  "bin": {
    "agent402-model-provider": "cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "known-assets.js",
    "provider.js",
    "models.js",
    "models.d.ts",
    "proxy.js",
    "proxy.d.ts",
    "cli.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.8.1"
    },
    "install": {
      "minHostVersion": ">=2026.7.1",
      "npmSpec": "agent402-model-provider"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.js"
  },
  "peerDependencies": {
    "@x402/evm": ">=2.20.0 <3",
    "@x402/fetch": ">=2.20.0 <3",
    "viem": ">=2.48.11 <3"
  },
  "peerDependenciesMeta": {
    "@x402/evm": {
      "optional": true
    },
    "@x402/fetch": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "llm-router",
    "x402",
    "mpp",
    "ai-agents",
    "usdc",
    "agent402",
    "agentic-commerce"
  ],
  "author": "Cardhavok LLC (doing business as Havok Holdings LLC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeyPetrillo/Agent402.git",
    "directory": "openclaw"
  },
  "homepage": "https://agent402.tools/guides/openclaw-model-provider"
}
