# Secretless browser + media worker image (audit F02/F04/F06).
#
# Same hardened base as the main service (non-root via the gosu entrypoint,
# digest-pinned, ffmpeg + Chromium, setuid bits stripped) but its CMD runs
# worker/server.js, and — crucially — the Railway service for this image is
# deployed with NONE of the payment/DB/operator/provider secrets and NO /data
# volume. A boot guard in worker/server.js refuses to start if a forbidden
# secret is present, so the isolation can't be silently undone.
#
# Base pinned by DIGEST (matches the main image). Re-pin after a deliberate bump.
FROM node:22.23.5-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee

WORKDIR /app
ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
# A failed npm ci prints the tail of npm's debug log before the build fails
# with npm's own exit code (scripts/test-dockerfile-npm-log.js).
RUN { npm ci --omit=dev || { s=$?; echo "npm ci failed (exit $s); npm debug log:" >&2; \
      for f in "${HOME:-/root}"/.npm/_logs/*-debug-0.log; do [ -f "$f" ] && tail -n 200 "$f" >&2; done; exit $s; }; } \
  && npx playwright install --with-deps chromium \
  && apt-get update && apt-get install -y --no-install-recommends ffmpeg gosu \
  && rm -rf /var/lib/apt/lists/* \
  && gosu node true \
  && { command -v ffmpeg >/dev/null || { echo "FATAL: ffmpeg missing"; exit 1; }; } \
  && { command -v ffprobe >/dev/null || { echo "FATAL: ffprobe missing"; exit 1; }; }

# The worker imports only the browser/media code subtree (render.js, media-kit.js
# and their pure deps) — never payments/db/operator. Copy the whole src for
# simple resolution; the boot guard is the real control on what env it holds.
COPY src ./src
COPY worker ./worker

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Strip setuid/setgid bits (same hardening as the main image).
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

ENTRYPOINT ["docker-entrypoint.sh"]
EXPOSE 3999
CMD ["node", "worker/server.js"]
