{
  "name": "agent402-action-provider",
  "version": "0.3.0",
  "description": "Agent402 action provider for use with AgentKit: find, call and about actions over Agent402's 500+ pay-per-call web tools and skill packs (x402 or MPP; Agentic Finance) for agents with CDP, Privy, ZeroDev or viem wallets. Pays over x402 in USDC on Base from the agent's wallet, or with a prepaid credits key for Agent402's own services; the pure-CPU tools are free via proof-of-work. Formerly agent402-agentkit.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.js"
  },
  "keywords": [
    "agentkit",
    "x402",
    "ai-agents",
    "agent-tools",
    "llm-tools",
    "usdc",
    "base",
    "proof-of-work",
    "http-402",
    "micropayments",
    "agent402",
    "tool-discovery",
    "agentic-commerce",
    "agentic-finance",
    "aifi",
    "mpp"
  ],
  "author": "Cardhavok LLC (doing business as Havok Holdings LLC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeyPetrillo/Agent402.git",
    "directory": "adapters/agentkit"
  },
  "homepage": "https://agent402.tools",
  "dependencies": {
    "agent402-client": ">=0.8.21 <1.0.0"
  },
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.10.0 <1",
    "@x402/evm": ">=2.0.0 <3",
    "@x402/fetch": ">=2.0.0 <3",
    "zod": ">=3.23.0 <5"
  },
  "peerDependenciesMeta": {
    "@coinbase/agentkit": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    },
    "@x402/fetch": {
      "optional": true
    }
  }
}
