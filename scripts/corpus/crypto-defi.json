   "name": "a fixed block on ethereum",
   "input": {
    "block": "20000000",
    "network": "ethereum"
   },
   "expect": {
    "equals": {
     "number": 20000000,
     "network": "ethereum"
    },
    "populated": [
     "hash",
     "timestampIso",
     "gasUsed"
    ],
    "gt": {
     "txCount": 0
    }
   }
  },
