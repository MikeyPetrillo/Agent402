        "url": "https://raw.githubusercontent.com/ianare/exif-samples/master/jpg/Canon_40D.jpg",
        "colors": 1
      },
      "expect": {
        "count": {
          "colors": 1
        },
        "populated": [
          "colors[0]",
          "width"
        ]
      }
    },
    {
      "slug": "image-exif",
      "name": "a png with no exif is hasExif:false, not a 500",
      "input": {
        "url": "https://tesseract.projectnaptha.com/img/eng_bw.png"
      },
      "expect": {
        "equals": {
          "hasExif": false
        },
        "populated": [
          "width",
          "height"
        ]
      }
    },
