{
  "about": "Tier 1: keyless skill packs on second inputs (a 200 means at least one step succeeded; the summary counts them), plus media, PDF, feed and crawl tools.",
  "cases": [
    {
      "slug": "route-execute-pro",
      "name": "a local slug through the pro tier",
      "input": {
        "slug": "checksum",
        "params": {
          "data": "corpus"
        }
      },
      "expect": {
        "equals": {
          "receipt.slug": "checksum"
        },
        "matches": {
          "result.md5": "^[0-9a-f]{32}$"
        }
      }
    },
    {
      "slug": "captcha-verify",
      "name": "turnstile test secret always passes",
      "input": {
        "provider": "turnstile",
        "secret": "1x0000000000000000000000000000000AA",
        "token": "any"
      },
      "expect": {
        "equals": {
          "provider": "turnstile",
          "success": true
        }
      }
    },
    {
      "slug": "captcha-verify",
      "name": "turnstile always-fail secret",
      "input": {
        "provider": "turnstile",
        "secret": "2x0000000000000000000000000000000AA",
        "token": "any"
      },
      "expect": {
        "equals": {
          "success": false
        },
        "minCount": {
          "errorCodes": 1
        }
      }
    },
    {
      "slug": "archive-snapshot",
      "name": "a long-archived site",
      "input": {
        "url": "https://www.wikipedia.org",
        "timestamp": "2015"
      },
      "expect": {
        "equals": {
          "available": true
        },
        "populated": [
          "snapshot"
        ]
      }
    },
    {
      "slug": "audio-convert",
      "name": "ogg to mp3 at 64k",
      "input": {
        "url": "https://upload.wikimedia.org/wikipedia/commons/c/c8/Example.ogg",
        "bitrate": "64k"
      },
      "expect": {
        "equals": {
          "format": "mp3"
        },
        "gt": {
          "bytes": 10000
        },
        "minCount": {
          "mp3Base64": 1000
        }
      }
    },
    {
      "slug": "audio-normalize",
      "name": "target -16 lufs",
      "input": {
        "url": "https://upload.wikimedia.org/wikipedia/commons/c/c8/Example.ogg",
        "targetLufs": -16
      },
      "expect": {
        "equals": {
          "targetLufs": -16
        },
        "gt": {
          "bytes": 10000
        }
      }
    },
    {
      "slug": "favicon-grab",
      "name": "a site with a declared icon",
      "input": {
        "url": "https://www.wikipedia.org"
      },
      "expect": {
        "equals": {
          "found": true
        },
        "populated": [
          "iconUrl",
          "contentType"
        ],
        "gt": {
          "bytes": 100
        }
      }
    },
    {
      "slug": "feed-parse",
      "name": "an atom feed",
      "input": {
        "url": "https://github.com/nodejs/node/releases.atom",
        "limit": 3
      },
      "expect": {
        "matches": {
          "format": "atom"
        },
        "count": {
          "items": 3
        },
        "gte": {
          "itemCount": 3
        },
        "populated": [
          "items[0].title"
        ]
      }
    },
    {
      "slug": "feed-parse",
      "name": "a non-feed url is a 4xx",
      "input": {
        "url": "https://example.com"
      },
      "expect": {
        "status": 422
      }
    },
    {
      "slug": "image-crop",
      "name": "rotate and flip",
      "input": {
        "url": "https://raw.githubusercontent.com/ianare/exif-samples/master/jpg/Canon_40D.jpg",
        "left": 0,
        "top": 0,
        "width": 40,
        "height": 30,
        "rotate": 90,
        "flip": "horizontal",
        "dataUri": true
      },
      "expect": {
        "equals": {
          "width": 30,
          "height": 40
        },
        "matches": {
          "dataUri": "^data:image/"
        }
      }
    },
    {
      "slug": "image-dominant-color",
      "name": "one colour",
