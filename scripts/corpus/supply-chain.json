  {"slug": "mcp-package-check", "name": "an npx command line is parsed to its package and tag", "input": {"package": "npx -y agent402-mcp@latest"}, "expect": {"equals": {"package": "agent402-mcp", "requestedVersion": "latest", "binaries.0": "agent402-mcp", "installScripts.present": false, "repository.github": "MikeyPetrillo/Agent402"}, "gt": {"dependencies.runtime": 3}, "populated": ["version", "publishedAt", "maintainers.names.0", "signals.0"]}},
  {"slug": "mcp-package-check", "name": "an exact version answers that version", "input": {"package": "agent402-mcp", "version": "0.13.13"}, "expect": {"equals": {"version": "0.13.13", "requestedVersion": "0.13.13"}, "populated": ["publishedAt", "versionAgeDays"]}},
