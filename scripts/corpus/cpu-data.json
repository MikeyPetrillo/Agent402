  {
   "slug": "openapi-diff",
   "name": "removed required param is breaking",
   "input": {
    "before": {
     "openapi": "3.0.0",
     "paths": {
      "/a": {
       "get": {
        "parameters": [
         {
          "name": "id",
          "in": "query",
          "required": true
         }
        ],
        "responses": {
         "200": {}
        }
       }
      }
     }
    },
    "after": {
     "openapi": "3.0.0",
     "paths": {
      "/a": {
       "get": {
        "parameters": [
         {
          "name": "id",
          "in": "query",
          "required": true
         },
         {
          "name": "extra",
          "in": "query",
          "required": true
         }
        ],
        "responses": {
         "200": {}
        }
       }
      },
      "/b": {
       "post": {
        "responses": {
         "200": {}
        }
       }
      }
     }
    }
   },
   "expect": {
    "minCount": {
     "added": 1
    },
    "empty": [
     "removed"
    ],
    "gte": {
     "breakingCount": 1
    },
    "populated": [
     "summary"
    ]
   }
  },
  {
   "slug": "openapi-diff",
   "name": "identical specs have no changes",
   "input": {
    "before": {
     "openapi": "3.0.0",
     "paths": {
      "/x": {
       "get": {
        "responses": {
         "200": {}
        }
       }
      }
     }
    },
    "after": {
     "openapi": "3.0.0",
     "paths": {
      "/x": {
       "get": {
        "responses": {
         "200": {}
        }
       }
      }
     }
    }
   },
   "expect": {
    "empty": [
     "added",
     "removed",
     "changed"
    ],
    "equals": {
     "breaking": false,
     "breakingCount": 0
    }
   }
  },
  {
