   }
  },
  {
   "slug": "add-time",
   "name": "negative duration across a month boundary",
   "input": {
    "date": "2026-03-01T00:00:00Z",
    "duration": "-1h"
   },
   "expect": {
    "matches": {
     "result": "^2026-02-28T23:00"
    }
   }
  },
  {
   "slug": "add-time",
   "name": "weeks and minutes",
   "input": {
    "date": "2026-01-01T00:00:00Z",
    "duration": "1w 90m"
   },
   "expect": {
    "matches": {
     "result": "^2026-01-08T01:30"
    }
   }
  },
  {
   "slug": "linear-regression",
   "name": "perfect negative line",
   "input": {
    "x": [
     0,
     1,
     2,
     3
    ],
    "y": [
     10,
     8,
     6,
     4
    ],
