{
 "about": "Pure-CPU finance, time, statistics, colour, image and OpenAPI tools (tier 0).",
 "cases": [
  {
   "slug": "compound-interest",
   "name": "annual compounding, known answer",
   "input": {
    "principal": 5000,
    "annualRate": 0.07,
    "years": 3,
    "compoundingPerYear": 1
   },
   "expect": {
    "gte": {
     "futureValue": 6125.2
    },
    "lt": {
     "futureValue": 6125.3
    },
    "equals": {
     "periods": 3
    },
    "gt": {
     "totalInterest": 1125
    }
   }
  },
  {
   "slug": "compound-interest",
   "name": "zero rate returns principal",
   "input": {
    "principal": 100,
    "annualRate": 0,
    "years": 5
   },
   "expect": {
    "equals": {
     "futureValue": 100,
     "totalInterest": 0
    }
   }
  },
  {
   "slug": "compound-interest",
   "name": "negative principal is a 400",
   "input": {
    "principal": -1,
    "annualRate": 0.05,
    "years": 1
   },
   "expect": {
    "status": 400
   }
  },
  {
   "slug": "cagr",
   "name": "halving over 2 years is negative",
   "input": {
    "beginValue": 200,
    "endValue": 50,
    "years": 2
   },
   "expect": {
    "equals": {
     "cagr": -0.5,
     "totalGrowth": -0.75,
     "years": 2
    }
   }
  },
  {
   "slug": "percentage",
   "name": "a percent of b",
   "input": {
    "op": "of",
    "a": 25,
    "b": 120
   },
   "expect": {
    "equals": {
     "result": 30
    }
   }
  },
  {
   "slug": "percentage",
   "name": "unknown op is a 400",
   "input": {
    "op": "bogus",
    "a": 1,
    "b": 2
   },
   "expect": {
    "status": 400
   }
  },
  {
   "slug": "finance",
   "name": "compound op",
   "input": {
    "op": "compound",
    "principal": 1000,
    "annualRatePct": 12,
    "years": 2,
    "compoundsPerYear": 12
   },
   "expect": {
    "populated": [
     "futureValue"
    ],
    "gt": {
     "futureValue": 1269
    },
    "lt": {
     "futureValue": 1270
    }
   }
  },
  {
   "slug": "break-even",
   "name": "fractional units round up in revenue",
   "input": {
    "fixedCost": 1000,
    "pricePerUnit": 15,
    "variableCostPerUnit": 9
   },
   "expect": {
    "gte": {
     "breakEvenUnits": 166.6
    },
    "equals": {
     "contributionMargin": 6,
     "contributionMarginRatio": 0.4
    }
   }
  },
  {
   "slug": "break-even",
   "name": "price at or below variable cost is a 400",
   "input": {
    "fixedCost": 100,
    "pricePerUnit": 5,
    "variableCostPerUnit": 5
   },
   "expect": {
    "status": 400
   }
  },
  {
   "slug": "bond-price",
   "name": "par bond when coupon equals yield",
   "input": {
    "faceValue": 1000,
    "couponRate": 0.04,
    "yieldToMaturity": 0.04,
    "years": 5,
    "periodsPerYear": 1
   },
   "expect": {
    "gte": {
     "price": 999.99
    },
    "lt": {
     "price": 1000.01
    },
    "equals": {
     "periods": 5,
     "couponPerPeriod": 40
    }
   }
  },
  {
   "slug": "bond-price",
   "name": "zero-coupon discount",
   "input": {
    "faceValue": 1000,
    "couponRate": 0,
    "yieldToMaturity": 0.05,
    "years": 10,
    "periodsPerYear": 1
   },
   "expect": {
    "gt": {
     "price": 613
    },
    "lt": {
     "price": 614
    },
    "matches": {
     "premiumOrDiscount": "discount"
    }
   }
  },
  {
   "slug": "time-convert",
   "name": "millisecond epoch in a negative-offset zone",
   "input": {
    "value": 1781172000000,
    "tz": "America/Los_Angeles"
   },
   "expect": {
    "equals": {
     "epochSeconds": 1781172000,
     "epochMillis": 1781172000000
    },
    "matches": {
     "utc": "^2026-06-1[0-9]T",
     "local": "2026-06-1"
    }
   }
  },
  {
   "slug": "time-convert",
   "name": "iso string input",
   "input": {
    "value": "2026-01-01T00:00:00Z",
