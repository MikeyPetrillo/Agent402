{
  "about": "Pure-CPU text, encoding and parsing tools (tier 0). Inputs deliberately unlike each tool's documented example.",
  "cases": [
    {
      "slug": "hash",
      "name": "sha512 of unicode text",
      "input": {
        "text": "héllo wörld ✓",
        "algo": "sha512"
      },
      "expect": {
        "equals": {
          "algo": "sha512"
        },
        "matches": {
          "hex": "^[0-9a-f]{128}$"
        },
        "populated": [
          "base64"
        ]
      }
    },
    {
      "slug": "hash",
      "name": "md5 of empty-ish single char",
      "input": {
        "text": "a",
        "algo": "md5"
      },
      "expect": {
        "equals": {
          "hex": "0cc175b9c0f1b6a831c399e269772661"
        }
      }
    },
    {
      "slug": "hash",
      "name": "unknown algo is a self-explaining 400",
      "input": {
        "text": "x",
        "algo": "sha9"
      },
      "expect": {
        "status": 400
      }
    },
    {
      "slug": "checksum",
      "name": "known vector",
      "input": {
        "data": "The quick brown fox jumps over the lazy dog"
      },
      "expect": {
        "equals": {
          "md5": "9e107d9d372bb6826bd81d3542a419d6",
          "sha1": "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12",
          "crc32": "414fa339"
        },
        "matches": {
          "sha512": "^[0-9a-f]{128}$"
        }
      }
    },
    {
      "slug": "querystring",
      "name": "build from an object",
      "input": {
        "value": {
          "q": "hello world",
          "n": 2,
          "tags": [
            "a",
            "b"
          ]
        },
        "mode": "build"
      },
      "expect": {
        "matches": {
          "result": "^q=hello(%20|\\+)world&n=2&tags=a&tags=b$"
        }
      }
    },
    {
      "slug": "querystring",
      "name": "unknown mode is a 400",
      "input": {
        "value": "a=1",
        "mode": "stringify"
      },
      "expect": {
        "status": 400
      }
    },
    {
      "slug": "querystring",
      "name": "mode is case-insensitive",
      "input": {
        "value": "a=1",
        "mode": "Parse"
      },
      "expect": {
        "equals": {
          "result.a": "1"
        }
      }
    },
    {
      "slug": "querystring",
      "name": "object in parse mode is a 400, never [object Object]",
      "input": {
        "value": {
          "a": 1
        }
      },
      "expect": {
        "status": 400
      }
    },
    {
      "slug": "querystring",
      "name": "parse nested and repeated keys",
      "input": {
        "value": "x=1&x=2&y=%C3%A9&empty=",
        "mode": "parse"
      },
      "expect": {
        "populated": [
          "result"
        ],
        "truthy": [
          "result.x"
        ]
      }
    },
    {
      "slug": "regex",
      "name": "named groups, multiline",
      "input": {
        "pattern": "^(?<key>\\w+)=(?<val>\\d+)$",
        "flags": "gm",
        "text": "a=1\nb=22\nc=x\nd=4"
      },
      "expect": {
        "equals": {
          "matchCount": 3
        },
        "count": {
          "matches": 3
        }
      }
    },
    {
      "slug": "regex",
      "name": "no match is an honest zero",
      "input": {
        "pattern": "\\d{4}-\\d{2}-\\d{2}",
        "flags": "g",
        "text": "no dates here"
      },
      "expect": {
        "equals": {
          "matchCount": 0
        },
        "empty": [
          "matches"
        ]
      }
    },
    {
      "slug": "regex",
      "name": "invalid pattern is a 400",
      "input": {
        "pattern": "(unclosed",
        "text": "x"
      },
      "expect": {
        "status": 400
      }
    },
    {
      "slug": "text-stats",
      "name": "short multi-paragraph text",
      "input": {
        "text": "One two three. Four five!\n\nSix seven eight nine ten."
      },
      "expect": {
        "equals": {
          "words": 10,
          "paragraphs": 2
        },
        "gte": {
          "sentences": 3
        },
        "gt": {
          "characters": 40,
          "estimatedTokens": 5
        }
      }
    },
    {
      "slug": "text-stats",
      "name": "japanese text has no spaces: a character per word, 。 ends a sentence",
      "input": {
        "text": "日本語のテキストです。二文目。"
      },
      "expect": {
        "equals": {
          "characters": 15,
          "words": 13,
          "sentences": 2
        },
        "gte": {
          "estimatedTokens": 13
        }
      }
    },
    {
      "slug": "text-stats",
      "name": "a lone dash is punctuation and an emoji is one character",
      "input": {
        "text": "ship it - now 😀"
      },
      "expect": {
        "equals": {
          "characters": 15,
          "words": 3
        }
      }
    },
    {
      "slug": "redact",
      "name": "phone, email, card and ip",
      "input": {
        "text": "call +1 (415) 555-0199 or mail jo@corp.io, card 4111 1111 1111 1111 from 10.0.0.7"
      },
      "expect": {
        "populated": [
          "result",
          "counts"
        ],
        "matches": {
          "result": "^(?!.*jo@corp\\.io).*$"
        }
      }
    },
    {
      "slug": "redact",
      "name": "nothing to redact leaves text intact",
      "input": {
        "text": "plain sentence with nothing sensitive"
      },
      "expect": {
        "equals": {
          "result": "plain sentence with nothing sensitive"
        }
      }
    },
    {
      "slug": "morse",
      "name": "decode with word gaps",
      "input": {
        "text": ".... . .-.. .-.. --- / .-- --- .-. .-.. -..",
        "mode": "decode"
      },
      "expect": {
        "matches": {
          "result": "^HELLO WORLD$"
        }
      }
    },
    {
      "slug": "morse",
      "name": "encode digits",
      "input": {
        "text": "SOS 2026",
        "mode": "encode"
      },
      "expect": {
        "matches": {
          "result": "^\\.\\.\\. --- \\.\\.\\. / \\.\\.--- ----- \\.\\.--- -\\.\\.\\.\\.$"
        }
      }
    },
    {
      "slug": "rot13",
      "name": "shift 3 (caesar) round trip",
      "input": {
        "text": "Xyz abc",
        "shift": 3
      },
      "expect": {
        "equals": {
          "result": "Abc def"
        }
      }
    },
    {
      "slug": "rot13",
      "name": "default shift on mixed case",
      "input": {
        "text": "Hello, World!"
      },
      "expect": {
        "equals": {
          "result": "Uryyb, Jbeyq!"
        }
      }
    },
    {
      "slug": "html-entities",
      "name": "decode named + numeric entities",
      "input": {
        "text": "&lt;p&gt;caf&eacute; &#169; &amp; &#x263A;",
        "mode": "decode"
      },
      "expect": {
        "equals": {
          "result": "<p>café © & ☺"
        }
      }
    },
    {
      "slug": "extract-entities",
      "name": "multiple of each kind",
      "input": {
        "text": "cc @bob and @alice: a@b.co, c@d.org; see https://a.io/x and http://b.io #one #two"
      },
      "expect": {
        "count": {
          "emails": 2,
          "urls": 2,
          "mentions": 2,
          "hashtags": 2
        }
      }
    },
    {
      "slug": "extract-entities",
      "name": "none found is four empty arrays",
      "input": {
        "text": "nothing to find in this sentence"
      },
      "expect": {
        "empty": [
          "emails",
          "urls",
          "mentions",
          "hashtags"
        ]
      }
    },
    {
      "slug": "base64",
      "name": "decode unicode",
      "input": {
        "text": "aMOpbGxvIOKclA==",
        "mode": "decode"
      },
      "expect": {
        "equals": {
          "result": "héllo ✔"
        }
      }
    },
    {
      "slug": "base64",
      "name": "encode binary-ish",
      "input": {
        "text": "\u0000\u0001\u0002",
        "mode": "encode"
      },
      "expect": {
        "equals": {
          "result": "AAEC"
        }
      }
    },
    {
      "slug": "base32",
      "name": "decode",
      "input": {
        "text": "NBSWY3DP",
        "mode": "decode"
      },
      "expect": {
        "equals": {
          "result": "hello"
        }
      }
    },
    {
      "slug": "base58",
      "name": "decode a bitcoin-style string",
      "input": {
        "text": "9Ajdvzr",
        "mode": "decode"
      },
      "expect": {
        "equals": {
          "result": "Hello"
        }
      }
    },
    {
      "slug": "csv-to-json",
      "name": "semicolon delimiter, quoted field with comma",
      "input": {
        "csv": "name;city\n\"Doe, Jane\";Oslo\nBob;Rome\n",
        "delimiter": ";"
      },
      "expect": {
        "equals": {
          "count": 2,
          "rows[0].name": "Doe, Jane",
          "rows[1].city": "Rome"
        }
      }
    },
    {
      "slug": "csv-to-json",
      "name": "header false gives arrays",
      "input": {
        "csv": "1,2\n3,4",
        "header": false
      },
      "expect": {
        "equals": {
          "count": 2
        },
        "populated": [
          "rows[0]"
        ]
      }
    },
    {
      "slug": "csv-to-md",
      "name": "three columns four rows",
      "input": {
        "csv": "a,b,c\n1,2,3\n4,5,6\n7,8,9"
      },
      "expect": {
        "matches": {
          "markdown": "^\\| *a *\\| *b *\\| *c *\\|"
        },
        "minCount": {
          "markdown": 40
        }
      }
    },
    {
      "slug": "json-to-csv",
      "name": "nested + missing keys across rows",
      "input": {
        "json": [
          {
            "id": 1,
            "meta": {
              "k": "v"
            }
          },
          {
            "id": 2,
            "extra": true
          }
        ]
      },
      "expect": {
        "equals": {
          "rows": 2,
          "columns": 3
        },
        "matches": {
          "csv": "^id,meta\\.k,extra\\n1,v,\\n2,,true"
        }
      }
    },
    {
      "slug": "json-to-csv",
      "name": "empty array is a self-explaining 400",
      "input": {
        "json": []
      },
      "expect": {
        "status": 400
      }
    },
    {
      "slug": "json-flatten",
      "name": "unflatten dotted keys",
      "input": {
        "json": {
          "a.b.c": 1,
          "a.d": 2,
          "e": 3
        },
        "mode": "unflatten"
      },
      "expect": {
        "equals": {
          "result": {
            "a": {
              "b": {
                "c": 1
              },
              "d": 2
            },
            "e": 3
          }
        }
      }
    },
    {
      "slug": "json-flatten",
      "name": "flatten arrays",
      "input": {
        "json": {
          "xs": [
            1,
            {
              "y": 2
            }
          ]
        },
        "mode": "flatten"
      },
      "expect": {
        "populated": [
          "result"
        ],
        "equals": {
          "result.xs.0": 1,
          "result.xs.1.y": 2
        }
      }
    },
    {
      "slug": "json-merge",
      "name": "b overrides scalars, arrays replaced",
      "input": {
        "a": {
          "x": 1,
          "list": [
            1,
            2
          ],
          "deep": {
            "k": "a"
          }
        },
        "b": {
          "x": 2,
          "list": [
            3
          ],
          "deep": {
            "j": "b"
          }
        }
      },
      "expect": {
        "equals": {
          "result.x": 2,
          "result.deep": {
            "k": "a",
            "j": "b"
          }
        }
      }
    },
    {
      "slug": "json-query",
      "name": "path miss is found:false",
      "input": {
        "json": {
          "a": [
            1
          ]
        },
