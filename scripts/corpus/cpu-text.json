          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "age": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "expect": {
        "equals": {
          "valid": false
        },
        "minCount": {
          "errors": 2
        }
      }
    },
    {
      "slug": "json-validate",
      "name": "valid nested array schema",
      "input": {
        "data": {
          "xs": [
            1,
            2
          ]
        },
        "schema": {
          "type": "object",
          "properties": {
            "xs": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      },
      "expect": {
        "equals": {
          "valid": true
        },
        "empty": [
          "errors"
        ]
      }
    },
    {
      "slug": "yaml-to-json",
      "name": "nested maps, lists, multiline",
      "input": {
        "yaml": "svc:\n  ports:\n    - 80\n    - 443\n  note: |\n    two\n    lines\n"
      },
      "expect": {
        "equals": {
          "json.svc.ports": [
