# Your Base USDC receiving address (an Ethereum-style 0x... address).
# Every payment lands here. Required unless FREE_MODE=true.
WALLET_ADDRESS=

# Primary payment network. The copy-paste default is TESTNET so a fresh clone
# never silently takes real USDC before you mean it to. Switch to "base" (real
# USDC on Base mainnet) only when you intend to accept live money.
NETWORK=base-sepolia
# NETWORK=base                # real USDC on Base mainnet

# Optional: accept USDC on MULTIPLE chains (the agent picks the chain it holds
# funds on). Comma-separated; the primary NETWORK is always included first.
# Default = NETWORK only. Facilitator routing in multi-chain mode: CDP is
# tried first on every chain its /supported lists (Base included, which keeps
# Bazaar marketplace discovery; set the CDP keys below), PayAI settles the rest
# and is the settle fallback. Without CDP keys everything falls back to PayAI
# and the Bazaar stops indexing this seller (a warning is logged at boot).
# PAYMENT_NETWORKS=base,solana,polygon,arbitrum

# REQUIRED when PAYMENT_NETWORKS includes "solana": the base58 Solana address
# that receives USDC on Solana. Without it the Solana payment option is
# silently omitted from every 402 (a warning is logged at boot): buyers are
# never offered Solana and no Solana revenue is possible.
# IMPORTANT: the address must already have a USDC token account, or every
# buyer's payment fails on-chain simulation (InvalidAccountData) while your
# 402 looks healthy. One-time fix: send the address any amount of USDC on
# Solana before enabling. Boot checks this and warns (best-effort).
# SOLANA_WALLET_ADDRESS=

# Optional PayAI facilitator auth for multi-chain settlement. Its keyless
# allowance needs no keys; get keys at merchant.payai.network.
# PAYAI_API_KEY_ID=
# PAYAI_API_KEY_SECRET=

# Recommended for mainnet: Coinbase Developer Platform API keys (free,
# portal.cdp.coinbase.com). Enables settlement on Base mainnet AND lists
# your endpoints in the x402 Bazaar so agents can discover them.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Alternative to CDP keys: any x402 facilitator URL that supports your network.
# FACILITATOR_URL=

# Public URL of this deployment (used in docs/examples on the landing page).
# BASE_URL=https://your-app.up.railway.app

# Set to "true" to disable payments entirely (local demo only).
# FREE_MODE=false

# Reverse proxies in front of this server that append X-Forwarded-For.
# Unset = 0: the client address is the connection's and a client-sent
# X-Forwarded-For is ignored (a boot warning names this variable). Set 1
# behind a single edge proxy (Railway, a load balancer, nginx) so per-client
# rate limits see the real client.
# TRUST_PROXY_HOPS=1

# Sanctioned regions (src/sanctioned-regions.js): requests located by
# Cloudflare in a comprehensively sanctioned region are answered 451 before
# any payment work. Read only behind the authenticated CDN path (CDN_PROXY and
# CDN_ORIGIN_SECRET); the occupied regions of Ukraine need Cloudflare's "Add
# visitor location headers" managed transform (cf-region-code). Default on.
# SANCTIONS_GEO_BLOCK=on                 # "off" turns the block off
# SANCTIONS_GEO_COUNTRIES=CU,IR,KP,SY    # replaces the default country set
# Sanctions events (src/sanctions-events.js): kept in the state database, or
# this file without one; kept ten years (never less).
# SANCTIONS_EVENTS_FILE=/data/agent402-sanctions-events.jsonl
# SANCTIONS_EVENTS_RETENTION_YEARS=10
# Money records past retention (src/ledger-retention.js): a daily pass counts
# sales and resolved refunds older than 7 years and sanctions events older
# than 10; it deletes only with LEDGER_RETENTION=apply ("off" stops the pass).
# LEDGER_RETENTION=apply
# LEDGER_RETENTION_SALES_YEARS=7         # never under 7
# LEDGER_RETENTION_REFUND_YEARS=7        # never under 7

# OpenAI-compatible LLM gateway (/v1/chat/completions + tiers): OpenRouter
# API key from openrouter.ai; the gateway spends this account's prepaid
# balance per call. Unset = every /v1 route that calls a model through it
# returns 503.
# OPENROUTER_API_KEY=

# Stock data provider (src/tools/stock-provider.js) behind stock-quote,
# stock-history and the packs that run them. "off" (default) lists none of
# them; "databento" is active only with DATABENTO_API_KEY set. A new provider
# is one adapter file, its key and this setting.
# STOCK_DATA_PROVIDER=off
# DATABENTO_API_KEY=

# The tools that read the Kalshi API (src/kalshi-switch.js): "on" lists them;
# unset (default) lists none of them and their routes answer 503.
# KALSHI_TOOLS=

# Proof-of-work tier (the "pay with compute" alternative for non-payers).
# POW_DIFFICULTY=20            # leading zero bits (8-28); higher = more CPU per free call
# POW_SECRET=                 # stable secret so challenges survive restarts (unset = a fresh random secret per process; set one in production)

# Balance reads behind the check that a wallet's paid calls in flight are covered together
# (src/inflight-cover.js).
# INFLIGHT_COVER_READ_GAP_MS=10000      # a wallet's reads are at least this far apart; inside it its last read is judged as it is (1000 to 10000)
# INFLIGHT_COVER_READS_DAILY_MAX=       # reads a day that reach the capped on-chain data host (unset: a fifth of HARDCAP_ALCHEMY_CALLS; never over half of it)

# Similarity recall (/api/memory/remember + /recall). Defaults to a local
# lexical embedder (no key). Point these at any OpenAI-compatible /embeddings
# endpoint (OpenAI, Voyage, Together, DeepInfra, …) for true semantic recall.
# EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=

# Weather tools (src/tools/weather-kit.js): an Open-Meteo API key. Set = each
# request goes to that API's keyed host (the public host with a "customer-"
# prefix) with the key as `apikey`; unset = the public hosts, no key.
# OPEN_METEO_API_KEY=

# Optional: signed receipts (src/receipt-signing.js; off unless the key is
# set; paid mode only). Every settled, non-streamed paid 200 on x402, the MPP evm wire,
# Tempo and the card wire then carries Agent402-Receipt, a compact JWS (EdDSA,
# Ed25519) over the route, the request digest, the answer's sha256, the
# price, the rail, the network, the signed payer and the settlement. The
# public keys are served at /.well-known/agent402-receipt-key.json and
# POST /api/receipts/verify checks one (free, no egress). A value in any
# other format is refused at boot with the reason (never the value) and
# signing stays off.
# RECEIPT_SIGNING_KEY=              # a PKCS8 Ed25519 private key in PEM, the whole PEM base64-encoded as one line
# RECEIPT_SIGNING_KEY_ID=           # required with the key: 1-32 of A-Z a-z 0-9 . _ - (e.g. r1-2026-11)
# RECEIPT_SIGNING_KEY_VALID_FROM=   # optional ISO date the key signs from (published as validFrom)
# RECEIPT_RETIRED_KEYS=             # optional JSON array of earlier public keys still published: [{"kid","x","validFrom","validUntil"}], x the raw 32-byte public key in base64url

# Optional: referral copies of paid routes (off unless ALL eight required
# settings are present and usable; paid mode only). Each slug in
# REFERRAL_SLUGS is also served under /ref/<slug>, where the 402 pays a
# referral network's split contract (Base USDC, ReceiveWithAuthorization) at
# the direct route's own price and the call is settled, after the handler,
# through that network's facilitator on a request signed by
# REFERRAL_SIGNER_KEY. A slug whose upstream work the handler deadline cannot
# end, or that is identity-bound, long-running, binary or has a lasting
# effect, is left out at boot with a log line.
# A request with no input at all runs the tool's published example.
# Required:
# REFERRAL_PAY_TO=              # the network's split contract (0x address)
# REFERRAL_MERCHANT_ID=         # this merchant's id on that contract (a number): a payment counts only when routed to it
# REFERRAL_PAYOUT_ADDRESS=      # the wallet the contract pays this merchant's amount to (0x address)
# REFERRAL_FACILITATOR_URL=     # the network's facilitator (https)
# REFERRAL_SIGNER_KEY=          # a dedicated 32-byte hex key; signs facilitator requests only, holds no funds
# REFERRAL_SLUGS=               # comma list of catalog slugs
# REFERRAL_SETUP_URL=           # the network's setup document (https), echoed in the 402
# REFERRAL_COMMISSION_BPS=      # default:<bps>,<slug>:<bps> as agreed with the network; no built-in rate. It sets the least amount a receipt must show, the net a sale is booked at before its receipt is read, and the figure a sale is compared with: a sale under it reads attention, and sales under the stop floor stop the slug
# Optional (default):
# REFERRAL_FEE_BPS=0                    # the network's fee, read with the commission map above (the same three uses)
# REFERRAL_DEADLINE_MS=25000            # handler budget
# REFERRAL_SETTLE_MS=60000              # /settle timeout (it waits for the receipt; the facilitator answers within 55 s, and a value under that is a boot warning); a request through the CDN proxy waits less when its verify and run left less before the proxy's answer deadline
# REFERRAL_VERIFY_MS=10000              # /verify timeout
# REFERRAL_SETTLE_RESERVE_MS=10000      # validity an authorization must keep after the handler
#                                       # (deadline + reserve + verify must fit 60 s, or the gate stays off)
# REFERRAL_MAX_VALIDITY_MS=900000       # the furthest ahead an authorization may expire
# REFERRAL_MAX_ANSWER_BYTES=64000       # the most bytes of one answer the network passes on to a buyer: a larger answer is a 413 before settlement, not settled, and counts as an unsettled run of its payer
# REFERRAL_VERIFY_SIGNED=on             # off: send /verify without the signed headers
# REFERRAL_UNSETTLED_MAX=3              # unsettled runs per payer (over half its outcomes) before a 429...
# REFERRAL_UNSETTLED_WINDOW_MS=900000   # ...in this window, before a 429
# REFERRAL_MAX_INFLIGHT=24              # paid calls in flight before a 503
# REFERRAL_PAYER_INFLIGHT_MAX=8        # one payer's paid calls in flight before a 429
# REFERRAL_UNSETTLED_HARD_MAX=40        # unsettled runs that refuse a payer whatever it settled
# REFERRAL_UNSETTLED_GLOBAL_MAX=12      # distinct failing payers past which a never-paid wallet is held at one
# REFERRAL_OVERSIZE_ALERT=30            # answers over REFERRAL_MAX_ANSWER_BYTES (413, each an unpaid tool run) from one client address in the unsettled-run window before the status word reads attention; an alarm only, nobody is refused for it
# REFERRAL_OWN_FAULT_MAX=3              # refusals of this server's own request in a row before calls are held...
# REFERRAL_OWN_FAULT_COOLDOWN_MS=60000  # ...for this long, answered 503 before the handler; then one call at a time probes
# REFERRAL_PARITY_GRANDFATHERED=        # comma list of slugs served although the public route gives them for less (default: none; each is named in a warning at every boot)
# REFERRAL_STORE_WRITE_MS=3000          # an intent write to the settlement store that has not answered by then is given up (503, nothing settled)
# REFERRAL_STORE_COOLDOWN_MS=15000      # a store hold lasts this long (doubling to 10 minutes while failures stay in the window), then a probe write must stand
# REFERRAL_STORE_WINDOW_MS=300000       # the window of intent-write failures (refused, or late): two in it hold paid calls before the handler
# REFERRAL_ROUTED_TOPIC=                # topic0 of the split contract's routed-payment event, when it is not the documented one
# REFERRAL_RECEIPT_WAIT_MS=4000         # how long a settle success's receipt is read before deciding
# REFERRAL_UNCONFIRMED_MAX=5            # answers delivered on a success whose receipt is not readable yet; past it they are held
# REFERRAL_UNRECOGNIZED_READS=5         # full readings of a receipt the proof rule does not recognize before an expired entry is closed to the operator record
# REFERRAL_MIN_NET_BPS=                 # default:<bps>,<slug>:<bps>: the least share of the price a sale must bring; under it counts toward the slug's stop (unset: 7000 for a model-backed tool, half the expected net for any other)
# REFERRAL_SHORT_NET_MAX=3              # sales on one slug under that floor before new calls on it answer 503; a model-backed tool stops at one (0: never)
# REFERRAL_PRODUCT_IDS=                 # <slug>:<0x 32-byte id>,...: the product id the split contract's routed event must name for that slug
# REFERRAL_SEND_IDLE_MS=15000           # an answer's send with no progress for this long is ended
# REFERRAL_SEND_MAX_MS=120000           # an answer's send is ended this long after it began
# REFERRAL_HANGUP_KEY_USD=           # this route's own hang-up forgiveness budgets, per payer and per address...
# REFERRAL_HANGUP_GLOBAL_USD=           # ...and route-wide (defaults: the direct routes' sizes), per
# REFERRAL_HANGUP_WINDOW_MS=86400000    # this window
# REFERRAL_SWEEP_MS=60000               # how often open settlements are read against the chain
# REFERRAL_BOOK_FILE=                   # the open-settlement book's file when no state database is set
# REFERRAL_ANSWER_DIR=                  # where owed answers are kept (files on this host's disk, 10 minutes at most)

# CoinGecko reads of calls that end unsettled (an unknown id) hold a share of the day
# (src/tools/coingecko-rate.js); one caller address holds at most this many places an hour, past
# which its unconfirmed ids are checked against their list first (a real id is still read).
# COINGECKO_UNSETTLED_PER_CALLER_HOUR=8

# Card store directories when no state database is set (default <data root>/credits and
# <data root>/human-checkout; the legacy human-checkout.json is read beside the latter).
# With a state database the report store's directory still keeps _pending-finals.ndjson
# (final records waiting to reach the database).
# CREDITS_DIR=
# HUMAN_CHECKOUT_DIR=
# The credits file store (no state database) keeps its key-id and email lookup index in each
# process's memory, built from the files and kept by that process's own writes: run one server
# process on a CREDITS_DIR (or set a state database) so a balance bought through one process is
# found by the balance page of another.
# With a state database the balance page's two lookups use expression indexes on the records
# table, built CONCURRENTLY in the background after the store loads (one container at a time).
# CREDITS_INDEXES=on                    # off: leave the build to an operator
# CREDITS_INDEX_DELAY_MS=60000          # how long after the store's first load the build starts

# Upstream buyer wallet trend (src/upstream-buyer-status.js): the high-water mark and the count of
# reads below it are kept in the state database when one is set; without one, in this file.
# UPSTREAM_BUYER_TREND_FILE=            # unset with no state database: process memory (a restart forgets the trend)

# Paid-call funnel (src/funnel.js, src/funnel-sources.js; counts on the traffic store's day rollups).
# FUNNEL_RETRY_WINDOW_MS=1800000        # how long a probing caller is watched for a credential
# FUNNEL_CALLER_CAP=50000               # callers watched at once (per replica)
# FUNNEL_FOUND_WINDOW_MS=21600000       # how long the discovery document a caller read is linked to its later calls
# FUNNEL_FOUND_CAP=50000                # callers whose last discovery document is held (per replica, memory only)
# Weekly scoreboard (scripts/scoreboard.js, run locally with AGENT402_OPERATOR_TOKEN):
# SCOREBOARD_PRIVATE_DIR=               # where its markdown report goes (default: this checkout's private project folder; never inside the repository)
